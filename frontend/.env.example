# Set this when calling a separately hosted Django API directly.
# Leave empty to use the Vite /api proxy during local development.
VITE_API_BASE_URL=

# Optional: override the local Django API target used by the Vite proxy.
# Defaults to http://127.0.0.1:8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
