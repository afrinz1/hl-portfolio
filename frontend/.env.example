# Copy this file to `.env` for local development.
#
# Only VITE_-prefixed variables are exposed to the browser bundle. Never put
# secrets, API keys or tokens here — anything in this file ships to the client.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Base URL of the Django API. The client normalises this and appends /api/v1.
# Use `localhost` (not 127.0.0.1) so the SPA on :3000 and the API on :8000
# count as the same site and the CSRF + refresh cookies are sent.
VITE_API_BASE_URL=http://localhost:8000

# Alternative: leave VITE_API_BASE_URL empty to use relative /api/v1 requests
# through the Vite dev proxy (vite.config.ts). Same-origin, so no CORS at all,
# and it keeps working when the dev server is opened from a LAN address.
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Production (Vercel)
# ---------------------------------------------------------------------------
# Do NOT commit production values here. Set this in the Vercel dashboard:
#   Project → Settings → Environment Variables
#     VITE_API_BASE_URL = https://hl-portfolio-production.up.railway.app
# Vite bakes env vars in at build time, so redeploy after changing it.
