# Production build (Vercel) — `vite build` loads this automatically.
#
# These values are NOT secret: Vite inlines every VITE_* variable into the
# client bundle. They only need to be public so the SPA knows where the API is.
#
# Live backend (Railway):
VITE_API_BASE_URL=https://hl-portfolio-production.up.railway.app

# Note: an environment variable set in the Vercel dashboard
# (Project → Settings → Environment Variables) takes precedence over this file,
# so you can override the URL there without touching the repo.
